{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rackwright",
  "version": "3.3.0",
  "identifier": "com.dave.rackwright",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420",
             "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [ { "title": "Rackwright", "width": 1400, "height": 900 } ], "security": { "csp": null } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico", "icons/icon.png"] }
}
